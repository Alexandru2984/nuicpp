[Unit]
Description=NuiGraph Studio C++ service
After=network.target postgresql.service

[Service]
Type=simple
User=nuigraph
Group=nuigraph
WorkingDirectory=/opt/nuigraph-studio/current
LoadCredential=app.env:/etc/nuigraph-studio/app.env
ExecStartPre=/opt/nuigraph-studio/current/nuigraph-studio check-config ${CREDENTIALS_DIRECTORY}/app.env
ExecStart=/opt/nuigraph-studio/current/nuigraph-studio ${CREDENTIALS_DIRECTORY}/app.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateMounts=true
ProtectSystem=strict
ProtectHome=tmpfs
ReadOnlyPaths=/opt/nuigraph-studio
InaccessiblePaths=/etc/nuigraph-studio
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:18081
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
TasksMax=256
LimitNOFILE=4096
LimitCORE=0
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
