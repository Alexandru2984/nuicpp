# Copy to /etc/nuigraph-studio/test.env as root, replace every placeholder and
# chmod 0600. The database name must end in _test. Never put production
# credentials or the production database name in this file.
APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=18100
APP_BASE_URL=http://127.0.0.1:18100
DATABASE_URL=postgresql://nuigraph_test:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost/nuigraph_studio_test
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=REPLACE_WITH_A_VALID_PBKDF2_SHA256_HASH
SESSION_SIGNING_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
# Leave empty normally. During a planned signing-key rotation, set the old
# signing key here for at most the longest session lifetime (7 days). On the
# first split-key deploy it may equal OWNER_HASH_SECRET; otherwise keep distinct.
SESSION_SIGNING_SECRET_PREVIOUS=
CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_64_HEX_CHARACTER_SECRET
OWNER_HASH_SECRET=REPLACE_WITH_THE_STABLE_64_HEX_CHARACTER_OWNER_SECRET
RATE_LIMIT_SECRET=REPLACE_WITH_ANOTHER_64_HEX_CHARACTER_SECRET
PUBLIC_ACCESS=true
FRONTEND_SHELL=server
MAX_NODES_PER_DIAGRAM=1000
MAX_EDGES_PER_DIAGRAM=2000
MAX_VERSIONS_PER_DIAGRAM=50
MAX_IMPORT_BYTES=1048576
MAX_DIAGRAMS_PER_GUEST=60
MAX_DIAGRAMS_TOTAL=5000
MAX_LOGICAL_BYTES_PER_GUEST=33554432
MAX_LOGICAL_BYTES_TOTAL=536870912
# Automatic deletion is deliberately disabled in the example. Enabling it is
# irreversible and requires both a positive retention window and confirmation.
TRASH_RETENTION_DAYS=0
TRASH_RETENTION_CONFIRM=false
TRASH_PURGE_INTERVAL_SECONDS=3600
TRASH_PURGE_BATCH_SIZE=50
DB_POOL_SIZE=4
PROJECT_ROOT=/home/micu/nuicpp
