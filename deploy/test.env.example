# Copy to /etc/nuigraph-studio/test.env as root, replace every placeholder and
# chmod 0600. The database name must end in _test. Never put production
# credentials or the production database name in this file.
APP_ENV=test
APP_HOST=127.0.0.1
APP_PORT=18100
APP_BASE_URL=http://127.0.0.1:18100
DATABASE_URL=postgresql://nuigraph_test:REPLACE_WITH_URL_ENCODED_PASSWORD@localhost/nuigraph_studio_test
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=REPLACE_WITH_A_VALID_PBKDF2_SHA256_HASH
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_HEX_CHARACTERS
PUBLIC_ACCESS=true
FRONTEND_SHELL=server
MAX_NODES_PER_DIAGRAM=1000
MAX_EDGES_PER_DIAGRAM=2000
MAX_VERSIONS_PER_DIAGRAM=50
MAX_IMPORT_BYTES=1048576
MAX_DIAGRAMS_PER_GUEST=60
MAX_DIAGRAMS_TOTAL=5000
DB_POOL_SIZE=4
PROJECT_ROOT=/home/micu/nuicpp
